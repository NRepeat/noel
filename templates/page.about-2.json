        "template--14952484012092__e5285738-865c-41f9-96a0-9726c3fcab37-167388143848264c4b-0": {
          "type": "heading",
          "settings": {
            "title": "Interested in a Career in the High-End Furniture Industry?"
          }
        },
        "template--14952484012092__e5285738-865c-41f9-96a0-9726c3fcab37-167388143848264c4b-1": {
          "type": "text",
          "settings": {
            "enlarge_text": false,
            "text": "<p>You’ve come to the right place! We are currently interviewing candidates for the following positions:<\/p>"
          }
        }
      },
      "block_order": [
        "template--14952484012092__e5285738-865c-41f9-96a0-9726c3fcab37-167388143848264c4b-0",
