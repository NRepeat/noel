{% layout none %}

<html>
  <head>
    <title>Print Product</title>
    <style>
      body {
        font-family: 'Gotham Office Regular' !important;
        margin: 0;
        padding: 0;
        background: #fff;
        color: #222;
        overflow-x: hidden;
        overflow-y: hidden;
      }
      .print-modal {
        width: 92%;
        margin: 0 4%;
        /* max-width: 800px;
        margin: 0 auto;
        padding: 24px 24px 0px 24px;
        background: #fff;
        box-shadow: 0 0 0 0 #fff;
        position: relative; */
      }
      .print-flex {
        display: flex;
        /* gap: 32px; */
        align-items: flex-start;
        flex-direction: column;
      }
      .print-col {
        flex: 1 1 0;
      }
      .print-col--left {
        max-width: 340px;
        min-width: 220px;
        text-align: left;
      }
      .print-col--right {
        width: 46%;
        float: left;
        padding: 20px 0 0 4%;
      }
      .print-header {
        text-align: center;
        margin-bottom: 20px;
        display: flex;
        width: 100%;
        justify-content: space-between;
        padding-top: 20px;
      }
      .print-header--left {
        text-align: left;
        margin-bottom: 24px;
      }
      .print-logo {
        max-width: 200px;
        max-height: 70px;
        /* margin-bottom: 24px; */
      }
      .print-images {
        display: flex;
        flex-wrap: wrap;
        /* gap: 16px; */
        justify-content: center;
        /* margin-bottom: 24px; */
        text-align: left;
      }
      .print-images img {
        /* max-width: 260px;
        max-height: 200px; */
        object-fit: contain;
        /* border: 1px solid #eee;
        background: #fafafa; */
        /* padding: 8px; */
      }
      .print-title {
        font-size: 18px;
        text-transform: uppercase;
      }
      .print-subtitle {
        margin-top: 16px;
        font-size: 20px;
        font-weight: bold;
        padding-bottom: 10px;
      }
      .print-link {
        font-size: 1em;
        margin-bottom: 12px;
        color: #000 !important;
      }
      .print-link a,
      .print-link.printProductPrintPageLink.btn,
      .print-link a.printProductPrintPageLink.btn,
      #print-link.printProductPrintPageLink.btn {
        color: #555 !important;
        text-decoration: none !important;
        font-size: 16px;
      }
      .print-divider {
        border: none;
        border-top: 1px solid #bbb;
        margin: 12px 0 18px 0;
      }
      .print-meta-list {
        font-size: 1em;
        margin-bottom: 10px;
      }
      .print-meta-list div {
        margin-bottom: 2px;
        line-height: 1.4;
      }
      .print-meta-list strong {
        font-weight: bold;
        display: inline-block;
        min-width: 90px;
      }
      .print-description {
        margin-top: 18px;
        font-size: 1.05em;
        line-height: 1.6;
      }
      .print-cta {
        /* margin: 32px 0 0 0; */
        text-align: left;
      }
      .print-cta--top {
        /* position: absolute;
        top: 24px;
        right: 32px;
        margin: 0;
        z-index: 10; */
      }
      .left-atr {
        width: 28%;
        float: left;
        font-size: 12px;
        font-weight: bold;
        padding-right: 2% !important;
        text-align: right;
      }
      .right-atr {
        width: 70%;
        float: left;
        font-size: 12px;
      }
      .print-flex-container {
        display: flex;
        width: 100%;
      }
      @media print {
        #print-link,
        .print-cta,
        .printProductPrintPageLink {
          display: none !important;
        }
        body,
        .print-modal {
          box-shadow: none !important;
          background: #fff !important;
        }
        .print-flex {
          /* gap: 12px; */
        }
        .print-header{
          margin-bottom: 20px;
        }
        .print-cta {
          display: none !important;
        }
        .print-images img {
          max-width: 290px;
          object-fit: contain;
        }
        .print-flex-container {
          flex-direction: row !important;
        }
      }

      @media (max-width: 800px) {
        .print-flex {
          flex-direction: column;
          /* gap: 16px; */
        }
        .print-flex-container {
          flex-direction: column;
        }
        .print-col--left {
          max-width: 100%;
          min-width: auto;
          text-align: center;
        }
        .print-col--right {
          padding: 0;
          min-width: auto;
          width: 100%;
        }
        .print-images img {
          max-width: 100%;
          width: 100%;
          width: 400px;
          height: 350px;
        }
        .print-meta-list--twocol {
          flex-direction: column;
          gap: 8px;
        }
        .print-cta--top {
          position: absolute;
          text-align: right;
          z-index: 1000;
          width: 100%;
          top: -20px;
          right: 20px;
        }
      }
    </style>
  </head>
  <body>
    <div class="print-modal print-flex">
      <div class="print-header ">
        {% assign logo = 'Logo.png' %}
        {% if logo %}
          <img
            class="print-logo"
            src="{{ 'Logo.png' | asset_url }}"
            alt="{{ shop.name }} logo"
            width="95"
            height="85"
          >
        {% endif %}
        <div class="print-cta ">
          <a id="print-link" href="javascript:" onclick="return PrintWindow();" class="printProductPrintPageLink btn"
            >PRINT PAGE</a
          >
        </div>
      </div>
      <hr
        style="
          margin: 0;
          width: 100%;
        "
      >
      <div style="" class="print-flex-container">
        <div class="print-images">
          {% if product.media.size > 0 %}
            {% for media in product.media limit: 1 %}
              {% if media.media_type == 'image' %}
                <img
                  src="{{ media | image_url: width: 600, height: 600 }}"
                  alt="{{ product.title }} image {{ forloop.index }}"
                  width="420"
                  height="320"
                >
              {% endif %}
            {% endfor %}
          {% else %}
            <img
              src="{{ product.featured_image | image_url: width: 600, height: 600 }}"
              alt="{{ product.title }}"
              width="420"
              height="320"
            >
          {% endif %}
        </div>
        <div class="print-col print-col--right">
          <div class="print-title">{{ product.title }}</div>
          <div class="print-subtitle">Noel Furniture</div>
          {% if shop.domain %}
            <div class="print-link">
              <a target="_blank" href="https://{{ shop.domain }}">www.{{ shop.domain }}</a>
            </div>
          {% endif %}
          <div class="print-meta-list">
            <ul style="padding:0;margin:0;">
              {% if product.selected_or_first_available_variant.sku and product.selected_or_first_available_variant.sku | strip != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> SKU: </span>
                  <span class="right-atr">
                    {{ product.selected_or_first_available_variant.sku | strip }}
                  </span>
                </li>
              {% endif %}
              {% if product.type and product.type | strip != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Type: </span>
                  <span class="right-atr">
                    {{ product.type | strip }}
                  </span>
                </li>
              {% endif %}
              {% if product.collections.first.title and product.collections.first.title | strip != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Category: </span>
                  <span class="right-atr">
                    {{ product.collections.first.title | strip }}
                  </span>
                </li>
              {% endif %}
              {% if product.collections[0].title and product.collections[0].title | strip != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Collection: </span>
                  <span class="right-atr">
                    {{ product.collections[0].title | strip }}
                  </span>
                </li>
              {% endif %}
              {% assign width = product.metafields.custom.width | strip %}
              {% assign depth = product.metafields.custom.depth | strip %}
              {% assign height = product.metafields.custom.height | strip %}
              {% assign weight = product.metafields.custom.weight | strip %}
              {% assign volume = product.metafields.custom.volume | strip %}
              {% assign diameter = product.metafields.custom.diameter | strip %}
              {% assign carton_width = product.metafields.custom.carton_width | strip %}
              {% assign carton_depth = product.metafields.custom.carton_depth | strip %}
              {% assign carton_height = product.metafields.custom.carton_height | strip %}
              {% assign finish = product.metafields.custom.finish | strip %}
              {% assign material = product.metafields.custom.material | strip %}
              {% if width != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Width: </span>
                  <span class="right-atr"> {{ width }}" </span>
                </li>
              {% endif %}
              {% if depth != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Depth: </span>
                  <span class="right-atr"> {{ depth }}" </span>
                </li>
              {% endif %}
              {% if height != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Height: </span>
                  <span class="right-atr"> {{ height }}" </span>
                </li>
              {% endif %}
              {% if weight != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Weight: </span>
                  <span class="right-atr"> {{ weight }} lbs </span>
                </li>
              {% endif %}
              {% if volume != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Volume: </span>
                  <span class="right-atr">
                    {{ volume }}
                  </span>
                </li>
              {% endif %}
              {% if diameter != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Diameter: </span>
                  <span class="right-atr"> {{ diameter }}" </span>
                </li>
              {% endif %}
              {% if carton_width != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Carton Width: </span>
                  <span class="right-atr">
                    {{ carton_width }}
                  </span>
                </li>
              {% endif %}
              {% if carton_depth != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Carton Depth: </span>
                  <span class="right-atr">
                    {{ carton_depth }}
                  </span>
                </li>
              {% endif %}
              {% if carton_height != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Carton Height: </span>
                  <span class="right-atr">
                    {{ carton_height }}
                  </span>
                </li>
              {% endif %}
              {% if finish != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Finish: </span>
                  <span class="right-atr">
                    {{ finish }}
                  </span>
                </li>
              {% endif %}
              {% if material != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Material: </span>
                  <span class="right-atr">
                    {{ material }}
                  </span>
                </li>
              {% endif %}
              {% if product.vendor and product.vendor | strip != '' %}
                <li style="list-style: none; line-height: 15px;">
                  <span class="left-atr"> Brand: </span>
                  <span class="right-atr">
                    {{ product.vendor | strip }}
                  </span>
                </li>
              {% endif %}
              {% if product.metafields.custom.product and product.metafields.custom.product | strip != '' %}
                <div><strong>Product:</strong> {{ product.metafields.custom.product | strip }}</div>
              {% endif %}
              {% if product.description and product.description | strip != '' %}
                <span class="left-atr"> Description: </span>
                <span class="right-atr">
                  {{ product.description | strip }}
                </span>
              {% endif %}
            </ul>
          </div>
          {% comment %}
            {% if shop.domain %}
              <div class="print-link">
                <a target="_blank" href="https://{{ shop.domain }}">www.{{ shop.domain }}</a>
              </div>
            {% endif %}
            <hr class="print-divider">
            <div class="print-meta-list">
              {% if product.selected_or_first_available_variant.sku and product.selected_or_first_available_variant.sku | strip != '' %}
                <div><strong>SKU:</strong> {{ product.selected_or_first_available_variant.sku | strip }}</div>
              {% endif %}
              {% if product.type and product.type | strip != '' %}
                <div><strong>Type:</strong> {{ product.type | strip }}</div>
              {% endif %}
              {% if product.collections.first.title and product.collections.first.title | strip != '' %}
                <div><strong>Category:</strong> {{ product.collections.first.title | strip }}</div>
              {% endif %}
              {% if product.collections[0].title and product.collections[0].title | strip != '' %}
                <div><strong>Collection:</strong> {{ product.collections[0].title | strip }}</div>
              {% endif %}
              {% assign width = product.metafields.custom.width | strip %}
              {% assign depth = product.metafields.custom.depth | strip %}
              {% assign height = product.metafields.custom.height | strip %}
              {% assign weight = product.metafields.custom.weight | strip %}
              {% assign volume = product.metafields.custom.volume | strip %}
              {% assign diameter = product.metafields.custom.diameter | strip %}
              {% assign carton_width = product.metafields.custom.carton_width | strip %}
              {% assign carton_depth = product.metafields.custom.carton_depth | strip %}
              {% assign carton_height = product.metafields.custom.carton_height | strip %}
              {% assign finish = product.metafields.custom.finish | strip %}
              {% assign material = product.metafields.custom.material | strip %}
              {% if width != '' %}
                <div><strong>Width:</strong> {{ width }}"</div>
              {% endif %}
              {% if depth != '' %}
                <div><strong>Depth:</strong> {{ depth }}"</div>
              {% endif %}
              {% if height != '' %}
                <div><strong>Height:</strong> {{ height }}"</div>
              {% endif %}
              {% if weight != '' %}
                <div><strong>Weight:</strong> {{ weight }} lbs</div>
              {% endif %}
              {% if volume != '' %}
                <div><strong>Volume:</strong> {{ volume }}</div>
              {% endif %}
              {% if diameter != '' %}
                <div><strong>Diameter:</strong> {{ diameter }}"</div>
              {% endif %}
              {% if carton_width != '' %}
                <div><strong>Carton Width:</strong> {{ carton_width }}</div>
              {% endif %}
              {% if carton_depth != '' %}
                <div><strong>Carton Depth:</strong> {{ carton_depth }}</div>
              {% endif %}
              {% if carton_height != '' %}
                <div><strong>Carton Height:</strong> {{ carton_height }}</div>
              {% endif %}
              {% if finish != '' %}
                <div><strong>Finish:</strong> {{ finish }}</div>
              {% endif %}
              {% if material != '' %}
                <div><strong>Material:</strong> {{ material }}</div>
              {% endif %}
              {% if product.vendor and product.vendor | strip != '' %}
                <div><strong>Brand:</strong> {{ product.vendor | strip }}</div>
              {% endif %}
            </div>
            <div class="print-meta-list">
              {% if product.metafields.custom.product and product.metafields.custom.product | strip != '' %}
                <div><strong>Product:</strong> {{ product.metafields.custom.product | strip }}</div>
              {% endif %}
              {% if product.description and product.description | strip != '' %}
                <div><strong>Description:</strong> {{ product.description | strip }}</div>
              {% endif %}
            </div>
          {% endcomment %}
        </div>
      </div>
      {% comment %}
        <div class="print-col print-col--left">
          <div class="print-header print-header--left">
            {% assign logo = 'Logo.png' %}
            {% if logo %}
              <img
                class="print-logo"
                src="{{ 'Logo.png' | asset_url }}"
                alt="{{ shop.name }} logo"
                width="200"
                height="90"
              >
            {% endif %}
          </div>
          <div class="print-images">
            {% if product.media.size > 0 %}
              {% for media in product.media limit: 1 %}
                {% if media.media_type == 'image' %}
                  <img
                    src="{{ media | image_url: width: 600, height: 600 }}"
                    alt="{{ product.title }} image {{ forloop.index }}"
                    width="420"
                    height="320"
                  >
                {% endif %}
              {% endfor %}
            {% else %}
              <img
                src="{{ product.featured_image | image_url: width: 600, height: 600 }}"
                alt="{{ product.title }}"
                width="320"
                height="220"
              >
            {% endif %}
          </div>
        </div>
      {% endcomment %}
      {% comment %}
        <div class="print-col print-col--right">
          <div class="print-title">{{ product.title }}</div>
          <div class="print-subtitle">{{ shop.name }}</div>
          {% if shop.domain %}
            <div class="print-link">
              <a target="_blank" href="https://{{ shop.domain }}">www.{{ shop.domain }}</a>
            </div>
          {% endif %}
          <hr class="print-divider">
          <div class="print-meta-list">
            {% if product.selected_or_first_available_variant.sku and product.selected_or_first_available_variant.sku | strip != '' %}
              <div><strong>SKU:</strong> {{ product.selected_or_first_available_variant.sku | strip }}</div>
            {% endif %}
            {% if product.type and product.type | strip != '' %}
              <div><strong>Type:</strong> {{ product.type | strip }}</div>
            {% endif %}
            {% if product.collections.first.title and product.collections.first.title | strip != '' %}
              <div><strong>Category:</strong> {{ product.collections.first.title | strip }}</div>
            {% endif %}
            {% if product.collections[0].title and product.collections[0].title | strip != '' %}
              <div><strong>Collection:</strong> {{ product.collections[0].title | strip }}</div>
            {% endif %}
            {% assign width = product.metafields.custom.width | strip %}
            {% assign depth = product.metafields.custom.depth | strip %}
            {% assign height = product.metafields.custom.height | strip %}
            {% assign weight = product.metafields.custom.weight | strip %}
            {% assign volume = product.metafields.custom.volume | strip %}
            {% assign diameter = product.metafields.custom.diameter | strip %}
            {% assign carton_width = product.metafields.custom.carton_width | strip %}
            {% assign carton_depth = product.metafields.custom.carton_depth | strip %}
            {% assign carton_height = product.metafields.custom.carton_height | strip %}
            {% assign finish = product.metafields.custom.finish | strip %}
            {% assign material = product.metafields.custom.material | strip %}
            {% if width != '' %}
              <div><strong>Width:</strong> {{ width }}"</div>
            {% endif %}
            {% if depth != '' %}
              <div><strong>Depth:</strong> {{ depth }}"</div>
            {% endif %}
            {% if height != '' %}
              <div><strong>Height:</strong> {{ height }}"</div>
            {% endif %}
            {% if weight != '' %}
              <div><strong>Weight:</strong> {{ weight }} lbs</div>
            {% endif %}
            {% if volume != '' %}
              <div><strong>Volume:</strong> {{ volume }}</div>
            {% endif %}
            {% if diameter != '' %}
              <div><strong>Diameter:</strong> {{ diameter }}"</div>
            {% endif %}
            {% if carton_width != '' %}
              <div><strong>Carton Width:</strong> {{ carton_width }}</div>
            {% endif %}
            {% if carton_depth != '' %}
              <div><strong>Carton Depth:</strong> {{ carton_depth }}</div>
            {% endif %}
            {% if carton_height != '' %}
              <div><strong>Carton Height:</strong> {{ carton_height }}</div>
            {% endif %}
            {% if finish != '' %}
              <div><strong>Finish:</strong> {{ finish }}</div>
            {% endif %}
            {% if material != '' %}
              <div><strong>Material:</strong> {{ material }}</div>
            {% endif %}
            {% if product.vendor and product.vendor | strip != '' %}
              <div><strong>Brand:</strong> {{ product.vendor | strip }}</div>
            {% endif %}
          </div>
          <div class="print-meta-list">
            {% if product.metafields.custom.product and product.metafields.custom.product | strip != '' %}
              <div><strong>Product:</strong> {{ product.metafields.custom.product | strip }}</div>
            {% endif %}
            {% if product.description and product.description | strip != '' %}
              <div><strong>Description:</strong> {{ product.description | strip }}</div>
            {% endif %}
            <div class="print-cta print-cta--top">
              <a id="print-link" href="javascript:" onclick="return PrintWindow();" class="printProductPrintPageLink btn"
                >PRINT PAGE</a
              >
            </div>
          </div>
        </div>
      {% endcomment %}
    </div>
    <script>
      function PrintWindow() {
        if (navigator.userAgent.toLowerCase().indexOf('firefox') != -1) {
          window.print();
        } else {
          document.execCommand('print', false, null);
        }
        return false;
      }
    </script>
  </body>
</html>
