{% layout none %}

<html>
  <head>
    <title>Print Product</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        padding: 0;
        background: #fff;
        color: #222;
        overflow: hidden;
      }
      .print-modal {
        max-width: 800px;
        margin: 0 auto;
        padding: 24px 24px 0px 24px;
        background: #fff;
        box-shadow: 0 0 0 0 #fff;
      }
      .print-flex {
        display: flex;
        gap: 32px;
        align-items: flex-start;
      }
      .print-col {
        flex: 1 1 0;
      }
      .print-col--left {
        max-width: 340px;
        min-width: 220px;
        text-align: left;
      }
      .print-col--right {
        flex: 2 1 0;
        min-width: 320px;
        padding-left: 16px;
      }
      .print-header {
        text-align: center;
        margin-bottom: 32px;
      }
      .print-header--left {
        text-align: left;
        margin-bottom: 24px;
      }
      .print-logo {
        max-width: 150px;
        max-height: 165px;
        margin-bottom: 24px;
      }
      .print-images {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
        justify-content: center;
        margin-bottom: 24px;
        text-align: left;
      }
      .print-images img {
        max-width: 260px;
        max-height: 200px;
        object-fit: contain;
        border: 1px solid #eee;
        background: #fafafa;
        padding: 8px;
      }
      .print-title {
        font-size: 1.4em;
        font-weight: bold;
        margin-bottom: 8px;
        margin-top: 0;
      }
      .print-subtitle {
        font-size: 1.1em;
        font-weight: bold;
        margin-bottom: 4px;
      }
      .print-link {
        font-size: 1em;
        margin-bottom: 12px;
        color: #000 !important;
      }
      .print-link a,
      .print-link.printProductPrintPageLink.btn,
      .print-link a.printProductPrintPageLink.btn,
      #print-link.printProductPrintPageLink.btn {
        color: #000 !important;
        text-decoration: underline !important;
      }
      .print-divider {
        border: none;
        border-top: 1px solid #bbb;
        margin: 12px 0 18px 0;
      }
      .print-meta-list {
        font-size: 1em;
        margin-bottom: 10px;
      }
      .print-meta-list div {
        margin-bottom: 2px;
        line-height: 1.4;
      }
      .print-meta-list strong {
        font-weight: bold;
        display: inline-block;
        min-width: 90px;
      }
      .print-description {
        margin-top: 18px;
        font-size: 1.05em;
        line-height: 1.6;
      }
      .print-cta {
        margin: 32px 0 0 0;
        text-align: left;
      }
      @media print {
        #print-link,
        .print-cta,
        .printProductPrintPageLink {
          display: none !important;
        }
        body,
        .print-modal {
          box-shadow: none !important;
          background: #fff !important;
        }
        .print-flex {
          gap: 12px;
        }
        .print-col--left {
          max-width: 220px;
        }
        .print-col--right {
          padding-left: 8px;
        }
      }
      @media (max-width: 700px) {
        .print-meta-list--twocol {
          flex-direction: column;
          gap: 8px;
        }
      }
    </style>
  </head>
  <body>
    <div class="print-modal print-flex">
      <div class="print-col print-col--left">
        <div class="print-header print-header--left">
          {% assign logo = settings.logo | default: settings.checkout_logo_image %}
          {% if logo %}
            <img
              class="print-logo"
              src="{{ logo | image_url: width: 400 }}"
              alt="{{ shop.name }} logo"
              width="200"
              height="90"
            >
          {% endif %}
        </div>
        <div class="print-images">
          {% if product.media.size > 0 %}
            {% for media in product.media limit: 1 %}
              {% if media.media_type == 'image' %}
                <img
                  src="{{ media | image_url: width: 600, height: 600 }}"
                  alt="{{ product.title }} image {{ forloop.index }}"
                  width="320"
                  height="220"
                >
              {% endif %}
            {% endfor %}
          {% else %}
            <img
              src="{{ product.featured_image | image_url: width: 600, height: 600 }}"
              alt="{{ product.title }}"
              width="320"
              height="220"
            >
          {% endif %}
        </div>
      </div>
      <div class="print-col print-col--right">
        <div class="print-title">{{ product.title }}</div>
        <div class="print-subtitle">{{ shop.name }}</div>
        {% if shop.domain %}
          <div class="print-link">
            <a target="_blank" href="https://{{ shop.domain }}">www.{{ shop.domain }}</a>
          </div>
        {% endif %}
        <hr class="print-divider">
        <div class="print-meta-list">
          {% if product.selected_or_first_available_variant.sku and product.selected_or_first_available_variant.sku | strip != '' %}
            <div><strong>SKU:</strong> {{ product.selected_or_first_available_variant.sku | strip }}</div>
          {% endif %}
          {% if product.type and product.type | strip != '' %}
            <div><strong>Type:</strong> {{ product.type | strip }}</div>
          {% endif %}
          {% if product.collections.first.title and product.collections.first.title | strip != '' %}
            <div><strong>Category:</strong> {{ product.collections.first.title | strip }}</div>
          {% endif %}
          {% if product.collections[0].title and product.collections[0].title | strip != '' %}
            <div><strong>Collection:</strong> {{ product.collections[0].title | strip }}</div>
          {% endif %}
          {% assign width = product.metafields.custom.width | strip %}
          {% assign depth = product.metafields.custom.depth | strip %}
          {% assign height = product.metafields.custom.height | strip %}
          {% assign weight = product.metafields.custom.weight | strip %}
          {% assign volume = product.metafields.custom.volume | strip %}
          {% assign diameter = product.metafields.custom.diameter | strip %}
          {% assign carton_width = product.metafields.custom.carton_width | strip %}
          {% assign carton_depth = product.metafields.custom.carton_depth | strip %}
          {% assign carton_height = product.metafields.custom.carton_height | strip %}
          {% assign finish = product.metafields.custom.finish | strip %}
          {% assign material = product.metafields.custom.material | strip %}
          {% if width != '' %}
            <div><strong>Width:</strong> {{ width }}"</div>
          {% endif %}
          {% if depth != '' %}
            <div><strong>Depth:</strong> {{ depth }}"</div>
          {% endif %}
          {% if height != '' %}
            <div><strong>Height:</strong> {{ height }}"</div>
          {% endif %}
          {% if weight != '' %}
            <div><strong>Weight:</strong> {{ weight }} lbs</div>
          {% endif %}
          {% if volume != '' %}
            <div><strong>Volume:</strong> {{ volume }}</div>
          {% endif %}
          {% if diameter != '' %}
            <div><strong>Diameter:</strong> {{ diameter }}"</div>
          {% endif %}
          {% if carton_width != '' %}
            <div><strong>Carton Width:</strong> {{ carton_width }}</div>
          {% endif %}
          {% if carton_depth != '' %}
            <div><strong>Carton Depth:</strong> {{ carton_depth }}</div>
          {% endif %}
          {% if carton_height != '' %}
            <div><strong>Carton Height:</strong> {{ carton_height }}</div>
          {% endif %}
          {% if finish != '' %}
            <div><strong>Finish:</strong> {{ finish }}</div>
          {% endif %}
          {% if material != '' %}
            <div><strong>Material:</strong> {{ material }}</div>
          {% endif %}
          {% if product.vendor and product.vendor | strip != '' %}
            <div><strong>Brand:</strong> {{ product.vendor | strip }}</div>
          {% endif %}
        </div>
        <div class="print-meta-list">
          {% if product.metafields.custom.product and product.metafields.custom.product | strip != '' %}
            <div><strong>Product:</strong> {{ product.metafields.custom.product | strip }}</div>
          {% endif %}
          {% if product.description and product.description | strip != '' %}
            <div><strong>Description:</strong> {{ product.description | strip }}</div>
          {% endif %}
        </div>
        <div class="print-cta">
          <a id="print-link" href="javascript:" onclick="return PrintWindow();" class="printProductPrintPageLink btn"
            >PRINT PAGE</a
          >
        </div>
      </div>
    </div>
    <script>
      function PrintWindow() {
        if (navigator.userAgent.toLowerCase().indexOf('firefox') != -1) {
          window.print();
        } else {
          document.execCommand('print', false, null);
        }
        return false;
      }
    </script>
  </body>
</html>
