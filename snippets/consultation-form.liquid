<div class="form-show-container">
  <a class="form-show">Schedule your consultation today</a>

  <div class="c3233 close">
    <a class="formClose" id="form-close-top"></a>
    <iframe
      id="JotFormIFrame-212306652675153"
      title="MAIN Request Your Design Consultation"
      onload="window.parent.scrollTo(0,0)"
      allowtransparency="true"
      allow="geolocation; microphone; camera; fullscreen"
      src="https://form.jotform.com/212306652675153"
      frameborder="0"
      style="min-width:100%;max-width:100%;height:539px;border:none;"
      scrolling="no"
    >
    </iframe>
    <script src='https://cdn.jotfor.ms/s/umd/latest/for-form-embed-handler.js'></script>
    <script>window.jotformEmbedHandler("iframe[id='JotFormIFrame-212306652675153']", "https://form.jotform.com/")</script>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const formBtn = document.querySelector('.form-show');
    const form = document.querySelector('.c3233');
    const closeFormBtn = document.getElementById('form-close-top');

    formBtn.addEventListener('click', () => {
      form.classList.remove('close');
      form.classList.add('active');
      window.scrollTo({ top: 0, behavior: 'smooth' });
    });

    closeFormBtn.addEventListener('click', () => {
      form.classList.remove('active');
      form.classList.add('close');
    });
  });
</script>
