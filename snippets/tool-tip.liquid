{%- liquid
	assign disabled_by_yoast_seo = true
	if content_for_header contains 'yoast-active-script'
		assign disabled_by_yoast_seo = false
	endif
-%}
<tool-tip data-tool-tip="{{ context }}">
  <div class="tool-tip__inner" data-tool-tip-inner>
    <button class="tool-tip__close" data-tool-tip-close=""><svg aria-hidden="true" focusable="false" role="presentation" class="icon icon-close" viewBox="0 0 64 64">{%- comment -%}Auto-disabled. Yoast plugin is taking care of SEO output.{%- endcomment -%}
{%- if disabled_by_yoast_seo -%}
<title>icon-X</title>
{%- comment -%} End Yoast auto-disable. {%- endcomment -%}
{%- endif -%}<path d="m19 17.61 27.12 27.13m0-27.12L19 44.74"/></svg></button>
    <div data-tool-tip-title>{{ page_title }}</div>
    <div class="tool-tip__content" data-tool-tip-content>
    </div>
  </div>
</tool-tip>
