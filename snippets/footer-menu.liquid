{%- if linklists[block.settings.menu].links.size > 0 -%}
  {% assign menu = linklists[block.settings.menu].links %}

  {%- if block.settings.show_footer_title -%}
    <h2 class="h4 footer__title small--hide">
      {{ linklists[block.settings.menu].title }}
    </h2>
    <button
      type="button"
      class="h4 footer__title collapsible-trigger collapsible-trigger-btn medium-up--hide"
      aria-controls="Footer-{{ block.id }}"
    >
      {{ linklists[block.settings.menu].title }}
      {%- render 'collapsible-icons' -%}
    </button>
  {%- endif -%}
  <div
    {% if block.settings.show_footer_title %}
      id="Footer-{{ block.id }}" class="collapsible-content collapsible-content--small"
    {% endif %}
  >
    <div class="collapsible-content__inner">
      <div class="footer__collapsible{% unless block.settings.show_footer_title %} footer_collapsible--disabled{% endunless %}">
        {% if menu.size == 1 %}
          <ul class="no-bullets site-footer__linklist">
            {%- for link in menu -%}
              <li>
                <a href="{{ link.url }}">{{ link.title }}</a>
              </li>
            {%- endfor -%}
          </ul>
        {% else %}
          <ul class="no-bullets site-footer__linklist--columns">
            {%- for link in menu -%}
              <li>
                <h2 class="h4 footer__title">{{ link.title }}</h2>
                <ul
                  class="no-bullets {% if link.links.size > 14 %}footer_two-columns{% endif %}"
                >
                  {% for childlink in link.links %}
                    {% unless childlink.title contains 'VIEW MORE' %}
                      <li>
                        <a href="{{ childlink.url }}">{{ childlink.title }}</a>
                      </li>
                    {% else %}
                      <li>
                        <p>
                          <a href="{{ childlink.url }}">
                            <strong>{{ childlink.title }}</strong>
                          </a>
                        </p>
                      </li>
                    {% endunless %}
                  {% endfor %}
                </ul>
              </li>
            {%- endfor -%}
          </ul>
        {% endif %}
      </div>
    </div>
  </div>
{%- endif -%}
