{%- if section.settings.divider -%}<div class="section--divider">{%- endif -%}

{% liquid
  assign collection_handle = product.vendor | handleize
  assign vendor_collection = collections[collection_handle]
  assign gallery = vendor_collection.metafields.custom.gallery.value
  assign first_image = gallery | first
  assign second_image = gallery | last

  assign image_width = section.settings.image_width
  assign overlap_images = true
  if first_image == blank or second_image == blank
    assign overlap_images = false
  endif

  if first_image == blank and second_image == blank
    assign overlap_images = true
    assign placeholder_images = true
  endif
%}

{% style %}
  {% if section.settings.top_padding == false %}
    .index-section { margin-top: 0 !important; }
  {% endif %}
  {% if section.settings.bottom_padding == false %}
    .index-section { margin-bottom: 0 !important; }
  {% endif %}
{% endstyle %}

{% if vendor_collection.description != blank or gallery != blank %}
<div class="index-section">

  <div class="page-width feature-row-wrapper feature-row--{{ image_width }}">
    {%- capture image_layout -%}
      <div class="feature-row__item feature-row__images{% if overlap_images %} feature-row__item--overlap-images{% endif %} {% if placeholder_images %}feature-row__item--placeholder-images{% endif %}" data-aos>
        {%- if first_image != blank -%}
            <div class="feature-row__first-image">
                <div class="image-wrap {% if section.settings.image_mask != 'none' %}svg-mask svg-mask--{{ section.settings.image_mask }}{% endif %}" style="height: 0; padding-bottom: {{ 100 | divided_by: first_image.aspect_ratio }}%;">
                  {%- liquid
                    if second_image == blank
                      assign sizeVariable = section.settings.image_width | append: 'vw'
                      assign fallback = '100vw'
                    else
                      assign sizeVariable = 'calc(0.4 * 50vw)'
                      assign fallback = '40vw'
                    endif

                    assign imageWidth = section.settings.image_width | times: 1
                    if imageWidth >= 50
                      assign loading = section.settings.lazyload_images
                    else
                      assign loading = true
                    endif
                  -%}
                  {%- render 'image-element',
                    img: first_image,
                    widths: '180, 360, 540, 750, 900, 1080',
                    loading: loading,
                    sizeVariable: sizeVariable,
                    fallback: fallback,
                    classes: 'feature-row__image',
                  -%}
                </div>
            </div>
          {%- endif -%}
          {%- if second_image != blank -%}
            <div class="feature-row__second-image">
                <div class="image-wrap {% if section.settings.image2_mask != 'none' %}svg-mask svg-mask--{{ section.settings.image2_mask }}{% endif %}" style="height: 0; padding-bottom: {{ 100 | divided_by: second_image.aspect_ratio }}%;">
                  {%- liquid
                    if first_image == blank
                      assign sizeVariable = section.settings.image_width | append: 'vw'
                      assign fallback = '100vw'
                    else
                      assign sizeVariable = 'calc(0.6 * 50vw)'
                      assign fallback = '60vw'
                    endif
                  -%}
                  {%- render 'image-element',
                    img: second_image,
                    widths: '180, 360, 540, 750, 900, 1080',
                    sizeVariable: sizeVariable,
                    fallback: fallback,
                    classes: 'feature-row__image',
                  -%}
                </div>
            </div>
          {%- endif -%}
      </div>
    {%- endcapture -%}

    <div class="feature-row">
      {%- if section.settings.layout == 'left' -%}
        {{ image_layout }}
      {%- endif -%}

      <div class="feature-row__item feature-row__text feature-row__text--{{ section.settings.layout }} text-{{ section.settings.align_text }}" data-aos>
        {%- if section.settings.subtitle != blank -%}
          <div class="subheading appear-delay{% cycle '','-1','-2','-3','-4' %}">{{ section.settings.subtitle }}</div>
        {%- endif -%}
        {%- if vendor_collection and vendor_collection.title != blank -%}
          <h2 class="h1 appear-delay{% cycle '','-1','-2','-3','-4' %}">{{ vendor_collection.title | escape }}</h2>
        {%- endif -%}
        
        {%- if vendor_collection and vendor_collection.description != blank -%}
          <div class="rte appear-delay{% cycle '','-1','-2','-3','-4' %}">
            <p>{{ vendor_collection.description }}</p>
          </div>
        {%- endif -%}
      </div>

      {%- if section.settings.layout == 'right' -%}
        {{ image_layout }}
      {%- endif -%}
    </div>
  </div>

</div>
{% endif %}

{%- if section.settings.divider -%}</div>{%- endif -%}

