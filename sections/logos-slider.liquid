<div class="logos-slider-container page-width--narrow">
  <span class="arrow-prev"></span>
  <div class="logos-slider">
    {% for block in section.blocks %}
      <img src="{{ block.settings.image | image_url }}" alt="{{ block.settings.image.alt }}" width="" height="">
    {% endfor %}
  </div>
  <span class="arrow-next"></span>
</div>

<script>
  $(document).ready(function () {
    var $slider = $('.logos-slider');
  
    $slider.slick({
      infinite: false,
      slidesToShow: 3,
      slidesToScroll: 1,
      autoplay: true,
      autoplaySpeed: 5000,
      arrows: true,
      prevArrow: $('.arrow-prev'),
      nextArrow: $('.arrow-next'),
      dots: true,
      responsive: [
        {
          breakpoint: 768,
          settings: {
            slidesToShow: 1
          }
        },
      ]
    });
  
    function updateArrows() {
      var currentSlide = $slider.slick('slickCurrentSlide');
      var totalSlides = $slider.slick('getSlick').slideCount;
      var slidesToShow = 3; // Change if different
  
      $('.arrow-prev').toggle(currentSlide !== 0);
      $('.arrow-next').toggle(currentSlide < totalSlides - slidesToShow);
    }
  
    updateArrows();
  
    $slider.on('afterChange', function () {
      updateArrows();
    });
  });
  
</script>

{% schema %}
{
  "name": "Logos slider",
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Logos slider"
    }
  ]
}
{% endschema %}