<section class="custom_contact_form">
  <div class="custom_contact_form_wrapper">
    <div class="left">
      <h2 class="">{{ section.settings.title }}</h2>
      <p>{{ section.settings.paragraph }}</p>

      <div class="custom_contact_form_blocks">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'content-item' %}
                <div class="contact_content_item">
                {% if block.settings.icon != blank %}
                  <img
                    src="{{ block.settings.icon | image_url }}"
                    alt="{{ block.settings.heading }}"
                    width=""
                    height="30"
                  >
                {% endif %}
              <div class="">
                <h4 class="contact_content_item_heading">{{ block.settings.heading }}</h4>
                <p>{{ block.settings.text }}</p>
              </div>
              </div>
          {% endcase %}
        {% endfor %}
      </div>
    </div>

    <div class="right">
      <h2>{{ section.settings.form_title }}</h2>

      {%- assign form_id = 'contact-' | append: section.id -%}
      {%- form 'contact', id: form_id -%}
        {%- if form.posted_successfully? -%}
          <p class="note note--success">
            {{ 'contact.form.post_success' | t }}
          </p>
        {%- endif -%}

        {{ form.errors | default_errors }}

        <label for="ContactFormName-{{ section.id }}">First name</label>
        <input
          type="text"
          id="ContactFormName-{{ section.id }}"
          class="input-full"
          name="contact[first-name]"
          placeholder="Enter your first name"
          autocapitalize="words"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        >

        <label for="ContactFormName-{{ section.id }}">Last name</label>
        <input
          type="text"
          id="ContactFormSurname-{{ section.id }}"
          class="input-full"
          name="contact[last-name]"
          placeholder="Enter your last name"
          autocapitalize="words"
          value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}"
        >

        <label for="ContactFormEmail-{{ section.id }}" class="required">{{ 'contact.form.email' | t }}</label>
        <input
          type="email"
          id="ContactFormEmail-{{ section.id }}"
          class="input-full"
          name="contact[email]"
          autocorrect="off"
          autocapitalize="off"
          placeholder="Enter your mail"
          value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
          required
        >

        <label for="ContactFormPhone-{{ section.id }}">{{ 'contact.form.phone' | t }}</label>
        <input
          type="tel"
          id="ContactFormPhone-{{ section.id }}"
          class="input-full"
          name="contact[phone]"
          pattern="[0-9\-]*"
          placeholder="Please type in your phone number..."
          value="{% if form.phone %}{{ form.phone }}{% elsif customer %}{{ customer.phone }}{% endif %}"
        >

        <label for="ContactFormMessage-{{ section.id }}" class="required">{{ 'contact.form.message' | t }}</label>
        <textarea
          rows="5"
          id="ContactFormMessage-{{ section.id }}"
          class="input-full"
          name="contact[body]"
          placeholder="Enter your message"
          required
        >{% if form.body %}{{ form.body }}{% endif %}</textarea>

        <label for="contact-form-submit-{{ section.id }}" class="hidden-label">{{ 'contact.form.send' | t }}</label>
        <button type="submit" id="contact-form-submit-{{ section.id }}" class="btn">
          {{ 'contact.form.send' | t }}
        </button>
      {%- endform -%}
    </div>

    <img
      src="{{ section.settings.image | image_url }}"
      alt="{{ section.settings.image.alt }}"
      width=""
      height=""
      class="cusotm_contact_form_image"
    >
  </div>
</section>

{% schema %}
{
  "name": "Custom contact",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Section title",
      "default": "Contact Us"
    },
    {
      "type": "textarea",
      "id": "paragraph",
      "label": "Paragraph"
    },
    {
      "type": "text",
      "id": "form_title",
      "label": "Form title",
      "default": "Get In Touch"
    }
  ],
  "blocks": [
    {
      "type": "content-item",
      "name": "Content item",
      "settings": [
        {
          "type": "image_picker",
          "id": "icon",
          "label": "Icon"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "Heading"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "text"
        }
      ]
    }
  ]
}
{% endschema %}
