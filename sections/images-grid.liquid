<style>
  #shopify-section-{{ section.id }} section {
    padding-block: {{ section.settings.padding }}px;
  }

  .images_grid_container {
    grid-template-columns: repeat({{ section.settings.columns }}, 1fr);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} section {
      padding-block: {{ section.settings.padding | times: 0.5 }}px;
    }
  }
</style>

<section class="page-width">
  {% unless section.settings.heading == blank %}
    <h2>{{ section.settings.heading }}</h2>
  {% endunless %}

  <div class="images_grid_container">
    {% for block in section.blocks %}
      {% case block.type %}
        {% when 'item' %}
          <div class="images_grid-item">
            <img
              src="{{ block.settings.image | image_url }}"
              alt="{{ block.settings.image.alt | escape }}"
              width=""
              height=""
            >
            <div class="images_grid-text">
              <span>{{ block.settings.text }}</span>
            </div>
          </div>
      {% endcase %}
    {% endfor %}
  </div>

  {% render 'consultation-form' %}
</section>

{% schema %}
{
  "name": "Images grid",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading"
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Number of columns",
      "options": [
        {
          "label": "Two",
          "value": "2"
        },
        {
          "label": "Three",
          "value": "3"
        },
        {
          "label": "Four",
          "value": "4"
        }
      ],
      "default": "4"
    },
    {
      "type": "range",
      "id": "padding",
      "label": "Section paddings",
      "min": 0,
      "max": 200,
      "step": 5,
      "default": 40,
      "unit": "px"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Images grid"
    }
  ]
}
{% endschema %}
